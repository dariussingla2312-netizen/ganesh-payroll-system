rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated owner can read or write data
    function isAuthenticated() {
      return request.auth != null;
    }

    // Validation for Aadhaar number (must be 12 digits if provided)
    function isValidAadhaar(aadhaar) {
      return aadhaar == null || (aadhaar is string && aadhaar.matches('^[0-9]{12}$'));
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read, write: if isAuthenticated() && isValidAadhaar(request.resource.data.aadhaar);
    }

    // Work types collection
    match /workTypes/{workTypeId} {
      allow read, write: if isAuthenticated();
    }

    // Employee individual rates collection
    match /employeeRates/{rateId} {
      allow read, write: if isAuthenticated();
    }

    // Daily work entries collection
    match /workEntries/{entryId} {
      allow read, write: if isAuthenticated();
    }

    // Advances collection
    match /advances/{advanceId} {
      allow read, write: if isAuthenticated();
    }

    // Leaves collection
    match /leaves/{leaveId} {
      allow read, write: if isAuthenticated();
    }

    // Salary payments collection
    match /salaryPayments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
  }
}
